@model AnhHoaBakery.Models.ThanhVien
@{
    ViewData["Title"] = "Tài khoản của bạn";
}

<div class="container mt-4">
    <div class="row">
        <div class="col-md-3">
            <div class="list-group">
                <a href="#" class="list-group-item list-group-item-action active">Thông tin tài khoản</a>
                <a href="#" class="list-group-item list-group-item-action">Lịch sử đơn hàng</a>
                <a asp-action="Logout" class="list-group-item list-group-item-action text-danger">Đăng xuất</a>
            </div>
        </div>
        <div class="col-md-9">
            <h3>Chỉnh sửa thông tin</h3>
            @if (ViewBag.Success != null)
            {
                <div class="alert alert-success">@ViewBag.Success</div>
            }

            <form asp-action="UpdateProfile" method="post">
                <div class="mb-3">
                    <label>Họ và tên</label>
                    <input asp-for="HoTen" class="form-control" />
                </div>
                <div class="mb-3">
                    <label>Số điện thoại</label>
                    <input asp-for="SoDienThoai" class="form-control" />
                </div>
                <div class="mb-3">
                    <label>Email</label>
                    <input asp-for="Email" class="form-control" />
                </div>
                <div class="mb-3">
                    <label>Địa chỉ</label>
                    <input asp-for="DiaChi" class="form-control" />
                </div>
                <div class="mb-3">
                    <label>Tên đăng nhập (Không thể đổi)</label>
                    <input asp-for="TenDangNhap" class="form-control" readonly disabled />
                </div>
                <div class="mb-3">
                    <label>Mật khẩu mới (Để trống nếu không muốn đổi)</label>
                    <input name="MatKhau" type="password" class="form-control" placeholder="Nhập mật khẩu mới..." />
                </div>
                <button type="submit" class="btn btn-primary">Cập nhật</button>
            </form>
        </div>
    </div>
</div>