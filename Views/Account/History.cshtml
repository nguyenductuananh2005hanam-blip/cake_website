@model IEnumerable<AnhHoaBakery.Models.DonHang>
@{
    ViewData["Title"] = "Lịch sử đơn hàng";
}

<div class="container mt-4">
    <h2 class="mb-4 text-primary fw-bold border-bottom pb-2">LỊCH SỬ ĐƠN HÀNG</h2>

    @if (Model == null || !Model.Any())
    {
        <div class="text-center py-5">
            <i class="fa fa-shopping-bag fa-3x text-muted mb-3"></i>
            <p class="text-muted">Bạn chưa có đơn hàng nào.</p>
            <a asp-controller="Home" asp-action="Index" class="btn btn-primary">Mua sắm ngay</a>
        </div>
    }
    else
    {
        <div class="row">
            @foreach (var order in Model)
            {
                <div class="col-md-12 mb-4">
                    <div class="card shadow-sm border-0">
                        <div class="card-header bg-white d-flex justify-content-between align-items-center py-3">
                            <div>
                                <span class="fw-bold">Mã đơn: #@order.MaDonHang</span>
                                <span class="text-muted ms-2">| @order.NgayDat.ToString("dd/MM/yyyy HH:mm")</span>
                            </div>
                            <div>
                                @if (order.TrangThai == "Mới đặt")
                                {
                                    <span class="badge bg-info text-dark">Mới đặt</span>
                                }
                                else if (order.TrangThai == "Đã giao")
                                {
                                    <span class="badge bg-success">Đã giao</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">@order.TrangThai</span>
                                }
                            </div>
                        </div>
                        <div class="card-body">
                            <div class="table-responsive">
                                <table class="table table-borderless mb-0">
                                    <thead class="text-muted small">
                                        <tr>
                                            <th>Sản phẩm</th>
                                            <th class="text-center">Số lượng</th>
                                            <th class="text-end">Đơn giá</th>
                                            <th class="text-end">Thành tiền</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var item in order.ChiTietDonHangs)
                                        {
                                            <tr class="border-bottom">
                                                <td>
                                                    <div class="d-flex align-items-center">
                                                        <img src="~/images/@item.Banh.HinhAnh" style="width: 50px; height: 50px; object-fit: cover;" class="rounded me-2" />
                                                        <span class="fw-bold text-dark">@item.Banh.TenBanh</span>
                                                    </div>
                                                </td>
                                                <td class="text-center align-middle">x @item.SoLuong</td>
                                                <td class="text-end align-middle">@item.DonGia.ToString("#,##0")đ</td>
                                                <td class="text-end align-middle fw-bold">@((item.SoLuong * item.DonGia).ToString("#,##0"))đ</td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        </div>
                        <div class="card-footer bg-light d-flex justify-content-between align-items-center">
                            <small class="text-muted"><i class="fa fa-map-marker-alt text-danger"></i> Giao đến: @order.DiaChiGiao (@order.SDTNhan)</small>
                            <h5 class="mb-0 fw-bold text-primary">Tổng tiền: @order.TongTien.ToString("#,##0")đ</h5>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>