@model IEnumerable<AnhHoaBakery.Models.DanhMuc>
@{
    ViewData["Title"] = "Danh mục bánh";
}

<div class="container mt-5">
    <h2 class="text-center mb-5 fw-bold text-primary">KHÁM PHÁ THẾ GIỚI BÁNH NGỌT</h2>

    <div class="row justify-content-center">
        @foreach (var item in Model)
        {
            <div class="col-md-4 mb-4">
                <a href="/Home/Index?categoryId=@item.MaDanhMuc" class="text-decoration-none">
                    <div class="card h-100 shadow-sm category-card text-white text-center" style="background-color: var(--primary-color);">
                        <div class="card-body d-flex flex-column align-items-center justify-content-center py-5">
                            <i class="fa fa-birthday-cake fa-3x mb-3 text-warning"></i>
                            <h3 class="card-title fw-bold text-uppercase">@item.TenDanhMuc</h3>
                            <p class="card-text text-white-50">@item.MoTa</p>
                            <span class="btn btn-light mt-3 text-primary fw-bold rounded-pill px-4">Xem ngay</span>
                        </div>
                    </div>
                </a>
            </div>
        }
    </div>
</div>

<style>
    .category-card {
        transition: transform 0.3s;
        border: none;
    }

        .category-card:hover {
            transform: translateY(-10px);
            box-shadow: 0 10px 20px rgba(0,0,0,0.2) !important;
            background-color: #0b5ed7 !important; /* Màu đậm hơn khi hover */
        }
</style>