@model List<AnhHoaBakery.Models.CartItem>
@{
    ViewData["Title"] = "Giỏ hàng";
}

<div class="container mt-5">
    <h2 class="mb-4 fw-bold text-primary">GIỎ HÀNG CỦA BẠN</h2>

    @if (Model.Count > 0)
    {
        <div class="table-responsive">
            <table class="table table-bordered align-middle">
                <thead class="table-light text-center">
                    <tr>
                        <th>Sản phẩm</th>
                        <th>Giá</th>
                        <th style="width: 150px;">Số lượng</th>
                        <th>Thành tiền</th>
                        <th>Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>
                                <div class="d-flex align-items-center">
                                    <img src="~/images/@item.HinhAnh" style="width: 80px; height: 80px; object-fit: cover;" class="rounded me-3 border" />
                                    <span class="fw-bold">@item.TenBanh</span>
                                </div>
                            </td>
                            <td class="text-center">@item.Gia.ToString("#,##0") đ</td>

                            <td>
                                <form asp-action="UpdateCart" method="post" class="d-flex justify-content-center">
                                    <input type="hidden" name="id" value="@item.MaBanh" />
                                    <input type="number" name="quantity" value="@item.SoLuong" min="1"
                                           class="form-control text-center me-2" style="width: 70px;"
                                           onchange="this.form.submit()" />
                                </form>
                            </td>

                            <td class="text-center fw-bold text-danger">@item.ThanhTien.ToString("#,##0") đ</td>
                            <td class="text-center">
                                <a asp-action="Remove" asp-route-id="@item.MaBanh" class="btn btn-outline-danger btn-sm" onclick="return confirm('Xóa sản phẩm này?')">
                                    <i class="fa fa-trash"></i> Xóa
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
                <tfoot class="table-light">
                    <tr>
                        <td colspan="3" class="text-end fw-bold fs-5">TỔNG CỘNG:</td>
                        <td colspan="2" class="fw-bold fs-4 text-danger text-end pe-4">
                            @Model.Sum(x => x.ThanhTien).ToString("#,##0") đ
                        </td>
                    </tr>
                </tfoot>
            </table>
        </div>

        <div class="d-flex justify-content-between mt-4">
            <a asp-controller="Home" asp-action="Index" class="btn btn-outline-secondary">
                <i class="fa fa-arrow-left"></i> Tiếp tục mua hàng
            </a>
            <a asp-controller="Cart" asp-action="Checkout" class="btn btn-primary btn-lg px-5">
                Thanh toán <i class="fa fa-check"></i>
            </a>
        </div>
    }
    else
    {
        <div class="text-center py-5">
            <img src="https://cdn-icons-png.flaticon.com/512/2038/2038854.png" width="100" class="mb-3 opacity-50" />
            <h4 class="text-muted">Giỏ hàng của bạn đang trống!</h4>
            <p>Hãy chọn thêm những chiếc bánh ngon tuyệt vời nhé.</p>
            <a asp-controller="Home" asp-action="Index" class="btn btn-primary mt-3">Quay lại trang chủ</a>
        </div>
    }
</div>