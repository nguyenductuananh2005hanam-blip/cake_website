@model List<AnhHoaBakery.Models.CartItem>
@{
    ViewData["Title"] = "Thanh toán";
}

<div class="container mt-4">
    <h2 class="mb-4 text-center text-uppercase fw-bold">Thông tin thanh toán</h2>

    <div class="row">
        <div class="col-md-5 order-md-2 mb-4">
            <h4 class="d-flex justify-content-between align-items-center mb-3">
                <span class="text-primary">Giỏ hàng của bạn</span>
                <span class="badge bg-primary rounded-pill">@Model.Sum(x => x.SoLuong)</span>
            </h4>
            <ul class="list-group mb-3 shadow-sm">
                @foreach (var item in Model)
                {
                    <li class="list-group-item d-flex justify-content-between lh-sm">
                        <div>
                            <h6 class="my-0">@item.TenBanh</h6>
                            <small class="text-muted">Số lượng: @item.SoLuong</small>
                        </div>
                        <span class="text-muted">@item.ThanhTien.ToString("#,##0")đ</span>
                    </li>
                }
                <li class="list-group-item d-flex justify-content-between bg-light">
                    <span class="fw-bold text-success">Tổng tiền (VNĐ)</span>
                    <strong class="text-success">@Model.Sum(x => x.ThanhTien).ToString("#,##0")</strong>
                </li>
            </ul>
        </div>

        <div class="col-md-7 order-md-1">
            <h4 class="mb-3">Thông tin giao hàng</h4>

            <form asp-action="ConfirmCheckout" method="post" class="needs-validation">
                <div class="row g-3">
                    <div class="col-12">
                        <label class="form-label">Họ và tên</label>
                        <input type="text" class="form-control" name="NguoiNhan" placeholder="Nhập họ tên người nhận" required>
                    </div>

                    <div class="col-md-6">
                        <label class="form-label">Số điện thoại</label>
                        <input type="text" class="form-control" name="SDT" placeholder="09xxx" required>
                    </div>

                    <div class="col-md-6">
                        <label class="form-label">Email <span class="text-muted">(Tùy chọn)</span></label>
                        <input type="email" class="form-control" placeholder="you@example.com">
                    </div>

                    <div class="col-md-4">
                        <label class="form-label">Tỉnh / Thành phố</label>
                        <select class="form-select">
                            <option value="">Hà Nội</option>
                            <option>TP. Hồ Chí Minh</option>
                        </select>
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">Quận / Huyện</label>
                        <select class="form-select">
                            <option value="">Chọn Quận/Huyện</option>
                            <option>Cầu Giấy</option>
                            <option>Hoàn Kiếm</option>
                            <option>Đống Đa</option>
                        </select>
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">Phường / Xã</label>
                        <select class="form-select">
                            <option value="">Chọn Phường/Xã</option>
                        </select>
                    </div>

                    <div class="col-12">
                        <label class="form-label">Địa chỉ chi tiết</label>
                        <input type="text" class="form-control" name="DiaChi" placeholder="Số nhà, tên đường..." required>
                    </div>
                </div>

                <hr class="my-4">

                <h4 class="mb-3">Phương thức nhận hàng</h4>
                <div class="form-check">
                    <input id="shipping" name="shippingMethod" type="radio" class="form-check-input" checked>
                    <label class="form-check-label" for="shipping">Giao hàng tận nơi (Phí 10k - 50k)</label>
                </div>
                <div class="form-check">
                    <input id="pickup" name="shippingMethod" type="radio" class="form-check-input">
                    <label class="form-check-label" for="pickup">Nhận tại cửa hàng</label>
                </div>

                <hr class="my-4">

                <h4 class="mb-3">Thanh toán</h4>
                <div class="form-check">
                    <input id="cod" name="paymentMethod" type="radio" class="form-check-input" checked>
                    <label class="form-check-label" for="cod">Thanh toán khi giao hàng (COD)</label>
                </div>

                <hr class="my-4">

                <button class="w-100 btn btn-primary btn-lg" type="submit">Xác nhận đặt hàng</button>
            </form>
        </div>
    </div>
</div>