@model AnhHoaBakery.Models.Banh
@{
    ViewData["Title"] = "Sửa thông tin bánh";
}

<div class="container mt-4">
    <div class="card shadow">
        <div class="card-header bg-warning text-dark">
            <h4 class="mb-0">Sửa thông tin bánh</h4>
        </div>
        <div class="card-body">
            <form asp-action="Edit" enctype="multipart/form-data" method="post">
                <input type="hidden" asp-for="MaBanh" />
                <input type="hidden" asp-for="HinhAnh" /> <div class="row">
                    <div class="col-md-6 mb-3">
                        <label class="form-label fw-bold">Tên bánh</label>
                        <input asp-for="TenBanh" class="form-control" required />
                    </div>
                    <div class="col-md-6 mb-3">
                        <label class="form-label fw-bold">Danh mục</label>
                        <select asp-for="MaDanhMuc" class="form-select" asp-items="ViewBag.MaDanhMuc"></select>
                    </div>
                    <div class="col-md-6 mb-3">
                        <label class="form-label fw-bold">Giá bán</label>
                        <input asp-for="Gia" type="number" class="form-control" required />
                    </div>
                    <div class="col-md-6 mb-3">
                        <label class="form-label fw-bold">Đổi ảnh (Nếu cần)</label>
                        <input type="file" name="fileAnh" class="form-control" />
                        <small class="text-muted">Ảnh hiện tại: @Model.HinhAnh</small>
                    </div>
                    <div class="col-12 mb-3">
                        <label class="form-label fw-bold">Mô tả</label>
                        <textarea asp-for="MoTa" class="form-control" rows="3"></textarea>
                    </div>
                </div>
                <button type="submit" class="btn btn-warning">Cập nhật</button>
                <a asp-action="Index" class="btn btn-secondary">Hủy</a>
            </form>
        </div>
    </div>
</div>