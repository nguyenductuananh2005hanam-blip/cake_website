@model AnhHoaBakery.Models.CuaHang

@{
    ViewData["Title"] = "Chỉnh sửa cửa hàng";
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card shadow border-0">
                <div class="card-header bg-warning text-dark">
                    <h5 class="mb-0 fw-bold">CẬP NHẬT THÔNG TIN CỬA HÀNG</h5>
                </div>
                <div class="card-body">
                    <form asp-action="Edit" enctype="multipart/form-data" method="post">
                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                        <input type="hidden" asp-for="MaCuaHang" />
                        <input type="hidden" asp-for="AnhMinhHoa" />

                        <div class="mb-3">
                            <label class="form-label fw-bold">Tên cửa hàng</label>
                            <input asp-for="TenCuaHang" class="form-control" required />
                            <span asp-validation-for="TenCuaHang" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-bold">Địa chỉ</label>
                            <input asp-for="DiaChi" class="form-control" required />
                            <span asp-validation-for="DiaChi" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-bold">Hotline</label>
                            <input asp-for="Hotline" class="form-control" />
                            <span asp-validation-for="Hotline" class="text-danger"></span>
                        </div>

                        <div class="mb-4">
                            <label class="form-label fw-bold">Ảnh cửa hàng</label>
                            <div class="d-flex align-items-center gap-3 mb-2">
                                @if (!string.IsNullOrEmpty(Model.AnhMinhHoa))
                                {
                                    <div class="text-center border p-1 rounded">
                                        <img src="~/images/@Model.AnhMinhHoa" style="width: 100px; height: 100px; object-fit: cover;" class="rounded" />
                                        <div class="small text-muted mt-1">Hiện tại</div>
                                    </div>
                                }
                                <div class="flex-grow-1">
                                    <input type="file" name="HinhAnhFile" class="form-control" accept="image/*" />
                                    <small class="text-muted fst-italic">* Để trống nếu muốn giữ nguyên ảnh cũ</small>
                                </div>
                            </div>
                        </div>

                        <div class="d-flex gap-2 justify-content-end">
                            <a asp-action="Index" class="btn btn-secondary">Hủy bỏ</a>
                            <button type="submit" class="btn btn-warning px-4 fw-bold">Cập nhật</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}