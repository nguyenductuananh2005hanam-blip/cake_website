@model IEnumerable<AnhHoaBakery.Models.CuaHang>
@{
    ViewData["Title"] = "Hệ thống cửa hàng";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2>Hệ thống cửa hàng</h2>
        <a asp-action="Create" class="btn btn-primary text-white">+ Thêm cửa hàng</a>
    </div>

    @foreach (var item in Model)
    {
        <div class="card mb-3 shadow-sm">
            <div class="card-body d-flex justify-content-between align-items-center">
                <div class="d-flex align-items-center">
                    <img src="~/images/@(item.AnhMinhHoa ?? "shop-icon.png")" style="width: 60px; height: 60px; object-fit: cover;" class="rounded me-3" />
                    <div>
                        <h5 class="card-title fw-bold mb-1">@item.MaCuaHang. Anh Hòa Bakery @item.MaCuaHang</h5>
                        <p class="mb-1 text-muted"><i class="fa fa-map-marker-alt text-danger"></i> @item.DiaChi</p>
                        <small class="text-success"><i class="fa fa-phone"></i> Hotline/Zalo: @item.Hotline</small>
                    </div>
                </div>
                <div>
                    <a asp-action="Edit" asp-route-id="@item.MaCuaHang" class="btn btn-primary btn-sm">Sửa</a>
                    <a asp-action="Delete" asp-route-id="@item.MaCuaHang" class="btn btn-danger btn-sm" onclick="return confirm('Xóa cửa hàng này?');">Xóa</a>
                </div>
            </div>
        </div>
    }
</div>